@inject CMCS_POE.Demo.DemoOptions Demo
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CMCS</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        .navbar-brand {
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .nav-link {
            position: relative;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem !important;
        }

        .nav-link:hover {
            transform: translateY(-2px);
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 3px;
            background: white;
            border-radius: 3px 3px 0 0;
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            border-radius: 0.5rem;
        }

        .dropdown-item {
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
            padding-left: 2rem;
        }

        footer {
            margin-top: auto;
            background: linear-gradient(to right, #f8f9fa, #e9ecef);
        }

        .alert {
            border: none;
            border-radius: 0.5rem;
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .quick-search {
            max-width: 300px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building me-2"></i>
                CMCS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @((currentController == "Home" || currentController == "Demo") ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Claim" ? "active" : "")"
                           asp-controller="Claim" asp-action="Index">
                            <i class="bi bi-person-badge me-1"></i>Claims
                        </a>
                    </li>
                    }
                    @if (User.IsInRole(WorkspaceRoles.Coordinator))
                    {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Coordinator" ? "active" : "")"
                           asp-controller="Coordinator" asp-action="Index">
                            <i class="bi bi-clipboard-check me-1"></i>Coordinator
                        </a>
                    </li>
                    }
                    @if (User.IsInRole(WorkspaceRoles.Manager))
                    {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Manager" ? "active" : "")"
                           asp-controller="Manager" asp-action="Index">
                            <i class="bi bi-shield-check me-1"></i>Manager
                        </a>
                    </li>
                    }
                    @if (User.IsInRole(WorkspaceRoles.HR))
                    {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "HR" ? "active" : "")"
                           asp-controller="HR" asp-action="Index">
                            <i class="bi bi-wallet2 me-1"></i>HR
                        </a>
                    </li>
                    }
                </ul>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    @await Html.PartialAsync("_DemoBanner")
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white small">@(User.FindFirst(WorkspaceRoles.DisplayNameClaim)?.Value ?? User.Identity?.Name ?? "Account")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                        </form>
                    }
                    else
                    {
                        if (Demo.Enabled)
                        {
                            <a asp-controller="Home" asp-action="Index" asp-fragment="dashboards" class="btn btn-light">Choose workspace</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light">Sign in</a>
                        }
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Success!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Error!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
            </div>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Warning!</strong> @TempData["Warning"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
            </div>
        </div>
    }

    <main id="main-content" role="main" class="flex-grow-1" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-top py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-building text-primary"></i> CMCS
                    </h5>
                    <p class="text-muted small">
                        Contract Monthly Claim System - claim submission, review and reporting.
                    </p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold mb-3">Your Workspace</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Account" asp-action="Workspace" class="text-muted text-decoration-none">Open my workspace</a></li>
                        @if (User.IsInRole(WorkspaceRoles.Lecturer))
                        {
                            <li><a asp-controller="Claim" asp-action="Create" class="text-muted text-decoration-none">Submit a claim</a></li>
                        }
                        @if (User.IsInRole(WorkspaceRoles.HR))
                        {
                            <li><a asp-controller="HR" asp-action="Lecturers" class="text-muted text-decoration-none">Lecturer records</a></li>
                            <li><a asp-controller="HR" asp-action="GenerateMonthlyReport" class="text-muted text-decoration-none">Monthly reports</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold mb-3">A Clear Review Process</h6>
                    <p class="text-muted small">Submit teaching hours, record coordinator and manager decisions, and keep approved payment records together.</p>
                </div>
            </div>
            <hr>
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <small class="text-muted">
                        &copy; @DateTime.Now.Year CMCS - Contract Monthly Claim System |
                        Developed by <strong>Mohammed</strong>
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-muted">
                        Claims &middot; Reviews &middot; Reports
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
