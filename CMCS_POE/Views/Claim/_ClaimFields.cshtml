@model CMCS_POE.Models.Claim
@{
    var canCalculate = double.IsFinite(Model.HoursWorked) && Model.HoursWorked >= 0 && Model.HoursWorked <= 200
        && Model.HourlyRate >= 0 && Model.HourlyRate <= 1000;
}
<input asp-for="ClaimId" type="hidden" />
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="claim-lecturer">Lecturer</label>
        <input id="claim-lecturer" class="form-control" value="@Model.LecturerName" readonly />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="claim-rate">Assigned hourly rate</label>
        <div class="input-group">
            <span class="input-group-text">R</span>
            <input id="claim-rate" class="form-control" value="@Model.HourlyRate.ToString("F2")"
                   data-rate="@Model.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" readonly />
        </div>
        <div class="form-text">Your rate is maintained in your lecturer record.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="Month" class="form-label">Claim month</label>
        <input asp-for="Month" type="month" class="form-control" required />
        <span asp-validation-for="Month" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="HoursWorked" class="form-label">Hours worked</label>
        <input asp-for="HoursWorked" id="claim-hours" type="number" step="0.5" min="1" max="200" class="form-control" required />
        <span asp-validation-for="HoursWorked" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label">Notes <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label for="claim-document" class="form-label">Supporting document <span class="text-muted">(optional)</span></label>
        <input id="claim-document" name="Document" type="file" class="form-control" accept=".pdf,.docx,.xlsx" aria-describedby="document-help" />
        <div id="document-help" class="form-text">PDF, DOCX or XLSX, up to 5 MB. A new file replaces the current attachment after your changes are saved.</div>
        @if (!string.IsNullOrEmpty(Model.DocumentName))
        {
            <p class="small mt-2">Current document:
                <a asp-controller="Claim" asp-action="DownloadFile" asp-route-id="@Model.ClaimId">@Model.DocumentName</a>
            </p>
        }
    </div>
    <div class="col-12">
        <div class="alert alert-light border mb-0">
            Estimated total: <strong id="claim-total" aria-live="polite">@(canCalculate ? "R " + Model.TotalAmount.ToString("N2") : "Enter valid hours")</strong>
        </div>
    </div>
</div>
